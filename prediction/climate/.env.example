# Climate & Flood Risk Prediction Service
# Copy to .env and fill in your paths

# Trained model artifacts (output of scripts/train_local.py)
MODEL_DIR=models_store

# NIMET station data (Karu LGA, Nasarawa State)
# If set, /flood-risk uses real rainfall + ET for Karu; others are zone-scaled
NIMET_RAINFALL_CSV=/path/to/dataset-rainfall.csv
NIMET_ET_CSV=/path/to/ET_dataset.csv

# LGAs downstream of Lagdo Dam (comma-separated lga_ids)
LAGDO_AFFECTED_LGAS=benue_makurdi,benue_guma,benue_logo

# CORS — should match your Next.js frontend URL
ALLOWED_ORIGINS=http://localhost:3000
